<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to list installed apps and check which app is in front. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- For Options > Updates: download and install new Lite Phone builds. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Approximate location, only for the weather next to the clock. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Calendar events on the Agenda page. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- For "My use" screen time. Granted by the passcode holder in Settings. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LiteApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LitePhone">

        <activity
            android:name=".LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PinActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".AdminActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".SetupActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".AllowedAppsActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".CategoryActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".ArrangeActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".CanvasSetupActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CustomizeActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".OptionsActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".UpdateActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
        <activity
            android:name=".UsageActivity"
            android:excludeFromRecents="true"
            android:exported="false" />

        <service
            android:name=".BadgeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".GuardService"
            android:exported="true"
            android:label="@string/guard_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>

        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
